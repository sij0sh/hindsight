# Keep config.json, registry.json, memory.json, migration/ backups, and generated views under version control when suitable for your repository.
# memory.json and migration/ may contain private provenance; review before sharing them.
# Treat this runtime state as local/private unless your team deliberately shares it.
.agents/curation/state.json
.agents/curation/run.lock
.agents/curation/transaction.json
.agents/curation/last-commit.json
.agents/curation/sessions/
.agents/curation/*/runs/
.agents/curation/*/last-investigation.json
