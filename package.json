{
  "name": "hindsight",
  "version": "0.2.0",
  "description": "Hindsight: scoped engineering memory with deterministic routing, evidence-driven Pi SDK curators, and generated views",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hindsight",
    "engineering",
    "documentation"
  ],
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "bin": {
    "hindsight": "./src/cli.mjs",
    "pi-knowledge": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/engine.mjs"
  },
  "files": [
    "extension.ts",
    "src",
    "catalog",
    "docs",
    "examples",
    "scripts",
    "test",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:sdk": "node scripts/sdk-smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  }
}
